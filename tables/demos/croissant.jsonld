  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "DEMOS",
  "description": "Ratings of human body movements averaged across raters on four dimensions. Item response data in the Item Response Warehouse (IRW), a harmonised collection of item-level response data for psychometric research. 10,656 responses from 2,664 respondents to 4 items. Classified as: Adult (18+); Educational; Opinion/attitude; Survey/questionnaire; Likert Scale/selected response; chi; Dalian Emotional Movement Open-source Set.",
  "url": "https://itemresponsewarehouse.org/tables/demos/",
  "version": "332.0.0",
  "datePublished": "2026-09-03",
  "license": "CC BY 4.0",
  "citation": "Zhang, M., Yu, L., Zhang, K., Du, B., Zhan, B., Jia, S., ... & Luo, W. (2023). Construction and validation of the Dalian emotional movement open-source set (DEMOS). Behavior Research Methods, 55(5), 2353-2366.",
  "citeAs": "Zhang, M., Yu, L., Zhang, K., Du, B., Zhan, B., Jia, S., ... & Luo, W. (2023). Construction and validation of the Dalian emotional movement open-source set (DEMOS). Behavior Research Methods, 55(5), 2353-2366.",
  "isLiveDataset": true,
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "redivis-table",
      "name": "redivis-table",
      "description": "The 'DEMOS' table as released on Redivis in item_response_warehouse v47.0.",
      "contentUrl": "https://stanford.redivis.com/datasets/as2e-cv7jb41fd/tables/hye4-d95c7d521?v=47.0",
      "encodingFormat": "text/csv",
      "sha256": null
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "responses",
      "name": "responses",
      "description": "One row per person-item response, per the IRW data standard.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "responses/id",
          "name": "id",
          "description": "The 'id' column of the IRW table.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "redivis-table"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "responses/item",
