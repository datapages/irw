  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "criticalperiod_syntax",
  "description": "Syntax questions. Item response data in the Item Response Warehouse (IRW), a harmonised collection of item-level response data for psychometric research. 107,483,095 responses from 1,131,401 respondents to 95 items. Classified as: Child (<18y); Adolescent (12-18y); Cognitive/educational; eng; Syntax questions.",
  "url": "https://itemresponsewarehouse.org/tables/criticalperiod_syntax/",
  "version": "341.0.0",
  "datePublished": "2026-09-04",
  "license": "CC BY 4.0",
  "citation": "Chen, T., & Hartshorne, J. K. (2021). More evidence from over 1.1 million subjects that the critical period for syntax closes in late adolescence. Cognition, 214, 104706.",
  "citeAs": "Chen, T., & Hartshorne, J. K. (2021). More evidence from over 1.1 million subjects that the critical period for syntax closes in late adolescence. Cognition, 214, 104706.",
  "isLiveDataset": true,
